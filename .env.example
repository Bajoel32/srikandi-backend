# Secret Edge Function — diset lewat `supabase secrets set --env-file .env`
# atau lewat Dashboard -> Edge Functions -> Secrets.
# JANGAN commit file .env yang sudah terisi.

# Hash-dari-hash kata sandi gerbang "Tim Sales" (lihat README bagian 3).
SALES_KEY_SHA256=

# API key asisten konsultasi (Gemini — ambil di https://aistudio.google.com/apikey).
# Kosong -> endpoint /consult balas 503 dan frontend otomatis jatuh ke mode mock.
GEMINI_API_KEY=

# Opsional
CONSULT_MODEL=gemini-3.5-flash
ALLOWED_ORIGINS=https://bajoel32.github.io,https://srikandi-admin.vercel.app,http://localhost:5173,http://localhost:4173
WHATSAPP_URL=https://wa.me/6281234567890
